{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "allowJs": false, "skipLibCheck": false, "verbatimModuleSyntax": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true,
    "lib": ["ES2024", "WebWorker"], "types": []
  },
  "include": ["scripts/offline-worker.ts", "scripts/assets.ts"]
}
