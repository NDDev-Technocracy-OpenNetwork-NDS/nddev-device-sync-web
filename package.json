{
  "name": "@nddev/nds-web",
  "version": "0.0.1-alpha.4",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.worker.json",
 "typecheck:ci": "bun run build && bun run typecheck",
    "generate:worker": "bun run scripts/generate-worker.ts",
    "check:worker": "bun run scripts/generate-worker.ts --check",
    "lint": "biome check src scripts/*.ts vite.config.ts",
    "test:organizations-browser": "bun test scripts/organizations-browser.test.ts",
    "test:organizations": "bun test src/pages/company/organization-owner.test.ts",
    "test:worker": "node --test scripts/offline-worker.test.ts",
    "build:ui": "vite build",
    "build": "bun run scripts/build-react.ts",
    "test:ci": "bunx playwright install --with-deps chromium && node --test --test-reporter=junit --test-reporter-destination=.nddev-reports/web.xml scripts/offline-worker.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.45",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "intl-messageformat": "12.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@tanstack/router-plugin": "1.168.47",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@biomejs/biome": "2.5.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "playwright": "1.64.1"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "24.22.0"
  }
}
